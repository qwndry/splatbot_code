    const timeCmd = new GetParameterCommand({ Name: "/bot/sysreplyTime" });
    const timeRes = await ssm.send(timeCmd);
    const sysreplyTimeTimestamp = parseInt(timeRes.Parameter.Value, 10);

    //if time > 0 and time has elapsed
    if (sysreplyTimeTimestamp > 0 && Date.now() >= sysreplyTimeTimestamp) {
      console.log("Timer expired! Automatically turning bot back on...");
      await sysreplyTurnOn(); 
      return true;
    }
  } catch (ssmError) {
    if (ssmError.name !== "ParameterNotFound") {
      console.error("Error reading /bot/sysreplyTime:", ssmError);
    }
  }

  //if the timer hasn't expired or timer === 0 (indefinite off)
  return false;
}

async function selfreplyTurnOn() {
  const val = new PutParameterCommand({
    Name: "/bot/selfreply",
    Value: "true",
    Overwrite: true,
    Type: "String"
  });
  await ssm.send(val);
}

async function selfreplyTurnOff() {
  const val = new PutParameterCommand({
    Name: "/bot/selfreply",
    Value: "false",
    Overwrite: true,
    Type: "String"
  });
  await ssm.send(val);

  const resetTime = new PutParameterCommand({
    Name: "/bot/selfreplyTime",
    Value: "0",
    Overwrite: true,
    Type: "String"
  });
  await ssm.send(resetTime);
}

async function selfreplyTurnOffFor(minutes) {
  const resumeTimestamp = Date.now() + (minutes * 60 * 1000);
  const val = new PutParameterCommand({
    Name: "/bot/selfreply",
    Value: "false",
    Overwrite: true,
    Type: "String"
  });
  await ssm.send(val);

  const setOffTimeCmd = new PutParameterCommand({
    Name: "/bot/selfreplyTime",
    Value: resumeTimestamp.toString(),
    Overwrite: true,
    Type: "String"
  });
  await ssm.send(setOffTimeCmd);
}

async function isselfreplyOn() {
  try {
    const cmd = new GetParameterCommand({ Name: "/bot/selfreply" });
    const res = await ssm.send(cmd);
    const selfReplyStatus = res.Parameter.Value === 'true';

    if (selfReplyStatus) return true;

    const timeCmd = new GetParameterCommand({ Name: "/bot/selfreplyTime" });
    const timeRes = await ssm.send(timeCmd);
    const selfreplyTimeTimestamp = parseInt(timeRes.Parameter.Value, 10);

    if (selfreplyTimeTimestamp > 0 && Date.now() >= selfreplyTimeTimestamp) {
      await selfreplyTurnOn();
      return true;
    }
  } catch (ssmError) {
    if (ssmError.name !== "ParameterNotFound") {
      console.error("Error reading /bot/selfreplyTime:", ssmError);
    }
  }
  return false;
}

